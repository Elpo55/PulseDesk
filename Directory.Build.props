<Project>

  <!--
    Product identity: the single source of truth for name, tagline, version, author, URL and license.
    These values are stamped into every assembly and read at runtime by Sysora.Core.AppInfo.
    Do not duplicate them anywhere else in the code base.
  -->
  <PropertyGroup Label="Product identity">
    <Product>Sysora</Product>
    <Version>1.2.0</Version>
    <Authors>Elpo55</Authors>
    <Company>$(Authors)</Company>
    <Copyright>Copyright (c) 2026 $(Authors)</Copyright>
    <Description>A lightweight, local-first Windows system dashboard.</Description>
    <SysoraTagline>Your PC, Explained.</SysoraTagline>
    <SysoraProjectUrl>https://github.com/Elpo55/Sysora</SysoraProjectUrl>
    <SysoraLicense>MIT</SysoraLicense>
  </PropertyGroup>

  <ItemGroup Label="Product identity metadata">
    <AssemblyMetadata Include="Sysora.Tagline" Value="$(SysoraTagline)" />
    <AssemblyMetadata Include="Sysora.ProjectUrl" Value="$(SysoraProjectUrl)" />
    <AssemblyMetadata Include="Sysora.License" Value="$(SysoraLicense)" />
    <AssemblyMetadata Include="Sysora.Authors" Value="$(Authors)" />
  </ItemGroup>

  <PropertyGroup Label="Build">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CI builds must stay warning-free. GitHub Actions sets CI=true. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
