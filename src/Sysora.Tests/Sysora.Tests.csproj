<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests. They never depend on the real hardware: Core logic is tested with simulated data,
    and Infrastructure is only tested through its pure parsing/normalization helpers.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Sysora.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sysora.Core\Sysora.Core.csproj" />
    <ProjectReference Include="..\Sysora.Infrastructure\Sysora.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests run with the invariant culture, so formatted values do not depend on the machine's regional settings. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
