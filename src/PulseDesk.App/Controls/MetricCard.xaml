<UserControl
    x:Class="PulseDesk.App.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PulseDesk.App.Controls">

    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontSize="16"
                    Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    CharacterSpacing="40"
                    Style="{StaticResource LabelTextStyle}"
                    Text="{x:Bind Title, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Margin="0,8,0,0"
                Style="{StaticResource LargeValueTextStyle}"
                Text="{x:Bind Value, Mode=OneWay}" />

            <TextBlock
                Grid.Row="2"
                MaxLines="1"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind Detail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Grid.Row="3"
                MaxLines="1"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind SecondaryDetail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <!-- Optional mini-graph of the last minutes (collapsed when no data is given). -->
            <local:Sparkline
                x:Name="Spark"
                Grid.Row="4"
                Height="36"
                Margin="0,10,0,0"
                VerticalAlignment="Bottom"
                Data="{x:Bind Sparkline, Mode=OneWay}"
                Stroke="{x:Bind AccentBrush, Mode=OneWay}" />

            <local:UsageBar
                x:Name="Bar"
                Grid.Row="5"
                Margin="0,12,0,0"
                Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
