<Page
    x:Class="PulseDesk.App.Views.DiagnosisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulseDesk.App.Controls"
    xmlns:vm="using:PulseDesk.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- One finding: a headline that is always visible, details on demand. -->
        <DataTemplate x:Key="DiagnosisItemTemplate" x:DataType="vm:DiagnosisItemViewModel">
            <Expander
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:StatusIcon Margin="0,2,0,0" VerticalAlignment="Top" BrushKey="{x:Bind BrushKey, Mode=OneWay}" Glyph="{x:Bind Glyph, Mode=OneWay}" GlyphSize="18" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Observed, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Why it matters" />
                        <TextBlock Text="{x:Bind Explanation, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2" Visibility="{x:Bind HasRecommendation, Mode=OneWay}">
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="What you can do" />
                        <TextBlock Text="{x:Bind Recommendation, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Reference, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ConfidenceText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind TimeText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Data used" />
                    <ItemsControl ItemsSource="{x:Bind Evidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EvidenceItemViewModel">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Metric}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Observed}" TextWrapping="Wrap" />
                                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        Command="{x:Bind OpenCommand}"
                        Content="{x:Bind ActionLabel, Mode=OneWay}"
                        Visibility="{x:Bind HasAction, Mode=OneWay}" />
                </StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Diagnosis" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Why is my PC slow? PulseDesk checks what it measures and explains what it finds." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.RunCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Analyze again" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Overall answer -->
            <Border Padding="20" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:StatusIcon VerticalAlignment="Top" BrushKey="{x:Bind ViewModel.StateBrushKey, Mode=OneWay}" Glyph="{x:Bind ViewModel.StateGlyph, Mode=OneWay}" GlyphSize="32" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Headline, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.AnalyzedText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.BaselineText, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compared with the history -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Compared with your usual activity" />
                    <TextBlock Text="{x:Bind ViewModel.ComparisonSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" Visibility="{x:Bind ViewModel.HasComparisonRows, Mode=OneWay}">
                        <StackPanel MinWidth="720">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Metric" />
                                <TextBlock Grid.Column="1" Style="{StaticResource LabelTextStyle}" Text="Now" ToolTipService.ToolTip="Average of the last 15 minutes" />
                                <TextBlock Grid.Column="2" Style="{StaticResource LabelTextStyle}" Text="Last hour" />
                                <TextBlock Grid.Column="3" Style="{StaticResource LabelTextStyle}" Text="Today" />
                                <TextBlock Grid.Column="4" Style="{StaticResource LabelTextStyle}" Text="Yesterday" />
                                <TextBlock Grid.Column="5" Style="{StaticResource LabelTextStyle}" Text="7 days" />
                                <TextBlock Grid.Column="6" Style="{StaticResource LabelTextStyle}" Text="30 days" />
                                <TextBlock Grid.Column="7" Style="{StaticResource LabelTextStyle}" Text="Usual at this hour" ToolTipService.ToolTip="Same hour of the day over the last 30 days (today excluded)" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ComparisonRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComparisonRowViewModel">
                                        <Grid Padding="0,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Now.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Now.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind LastHour.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind LastHour.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Today.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Today.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Yesterday.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Yesterday.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Last7Days.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Last7Days.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind Last30Days.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Last30Days.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="7" Text="{x:Bind Usual.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Usual.Tooltip, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Averages of the local history. A period without enough measured time shows a dash (hover it to see how much data exists): PulseDesk never fills the gap with an estimate." TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Problems detected -->
            <StackPanel Spacing="0" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Problems detected" />
                <ItemsControl ItemTemplate="{StaticResource DiagnosisItemTemplate}" ItemsSource="{x:Bind ViewModel.Problems}" />
            </StackPanel>

            <!-- Recommendations -->
            <StackPanel Visibility="{x:Bind ViewModel.HasRecommendations, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Recommendations" />
                <Border Style="{StaticResource CardStyle}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Margin="0,3,0,0" VerticalAlignment="Top" FontSize="12" Glyph="&#xE76C;" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Potential issues -->
            <StackPanel Visibility="{x:Bind ViewModel.HasPotential, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Points to watch" />
                <ItemsControl ItemTemplate="{StaticResource DiagnosisItemTemplate}" ItemsSource="{x:Bind ViewModel.Potential}" />
            </StackPanel>

            <!-- Normal -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Checked and normal" />
                <ItemsControl ItemTemplate="{StaticResource DiagnosisItemTemplate}" ItemsSource="{x:Bind ViewModel.NormalItems}" />
            </StackPanel>

            <!-- Not analyzed -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Not analyzed" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NotAnalyzed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Padding="0,2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="PulseDesk only reports what it measures. Rules are deterministic: the same measurements always give the same diagnosis." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
