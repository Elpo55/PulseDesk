<Page
    x:Class="PulseDesk.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulseDesk.App.Controls"
    xmlns:vm="using:PulseDesk.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Network" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Local statistics only — PulseDesk sends no network traffic to measure them" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Chart time span"
                    Header="Time span"
                    ItemsSource="{x:Bind ViewModel.WindowOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsDisabled, Mode=OneWay}"
                Message="Network monitoring is turned off in Settings."
                Severity="Informational" />

            <controls:AdaptiveGridPanel MinItemWidth="220">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock CharacterSpacing="40" Style="{StaticResource LabelTextStyle}" Text="CONNECTION" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:HealthGlyph Status="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ConnectionDetail, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <controls:MetricCard
                    Title="DOWNLOAD"
                    AccentBrush="{ThemeResource NetworkAccentBrush}"
                    Detail="Receive rate"
                    Glyph="&#xE896;"
                    Value="{x:Bind ViewModel.Download, Mode=OneWay}" />
                <controls:MetricCard
                    Title="UPLOAD"
                    AccentBrush="{ThemeResource NetworkSecondaryAccentBrush}"
                    Detail="Send rate"
                    Glyph="&#xE898;"
                    Value="{x:Bind ViewModel.Upload, Mode=OneWay}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock CharacterSpacing="40" Style="{StaticResource LabelTextStyle}" Text="ACTIVE INTERFACE" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.PrimaryName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.PrimaryAddress, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </controls:AdaptiveGridPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Throughput" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="3" VerticalAlignment="Center" Fill="{ThemeResource NetworkAccentBrush}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Download" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="3" VerticalAlignment="Center" Fill="{ThemeResource NetworkSecondaryAccentBrush}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Upload" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <controls:TimeSeriesChart
                        Grid.Row="1"
                        Height="220"
                        AutomationProperties.Name="Network throughput history"
                        Data="{x:Bind ViewModel.Chart, Mode=OneWay}"
                        SecondaryStroke="{ThemeResource NetworkSecondaryAccentBrush}"
                        Stroke="{ThemeResource NetworkAccentBrush}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Interfaces" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Interfaces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveGridPanel MinItemWidth="380" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkInterfaceItemViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="24" Foreground="{ThemeResource NetworkAccentBrush}" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Description, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Kind, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <controls:AdaptiveGridPanel MinItemWidth="140" RowSpacing="12">
                                    <controls:StatItem Label="Download" Value="{x:Bind Receive, Mode=OneWay}" />
                                    <controls:StatItem Label="Upload" Value="{x:Bind Send, Mode=OneWay}" />
                                    <controls:StatItem Label="Link speed" Value="{x:Bind Speed, Mode=OneWay}" />
                                    <controls:StatItem Label="Received" Value="{x:Bind Received, Mode=OneWay}" Hint="Since the interface came up" />
                                    <controls:StatItem Label="Sent" Value="{x:Bind Sent, Mode=OneWay}" Hint="Since the interface came up" />
                                    <controls:StatItem Label="IPv4" Value="{x:Bind IPv4, Mode=OneWay}" />
                                </controls:AdaptiveGridPanel>
                                <controls:StatItem Label="IPv6" Value="{x:Bind IPv6, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                Text="Latency is not measured: it would require contacting a remote server. Internet availability comes from Windows' own connectivity checks." />
        </StackPanel>
    </ScrollViewer>
</Page>
