<Page
    x:Class="PulseDesk.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulseDesk.App.Controls"
    xmlns:vm="using:PulseDesk.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <!-- Header with overall health -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Dashboard" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:HealthGlyph Status="{x:Bind ViewModel.OverallHealth, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.HealthSummary, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Key metrics -->
            <controls:AdaptiveGridPanel MinItemWidth="220">
                <controls:MetricCard
                    Title="CPU"
                    AccentBrush="{ThemeResource CpuAccentBrush}"
                    Detail="{x:Bind ViewModel.Cpu.Detail, Mode=OneWay}"
                    Glyph="&#xE950;"
                    Percent="{x:Bind ViewModel.Cpu.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Cpu.SecondaryDetail, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Cpu.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="MEMORY"
                    AccentBrush="{ThemeResource MemoryAccentBrush}"
                    Detail="{x:Bind ViewModel.Memory.Detail, Mode=OneWay}"
                    Glyph="&#xE964;"
                    Percent="{x:Bind ViewModel.Memory.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Memory.SecondaryDetail, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Memory.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="GPU"
                    AccentBrush="{ThemeResource GpuAccentBrush}"
                    Detail="{x:Bind ViewModel.Gpu.Detail, Mode=OneWay}"
                    Glyph="&#xEEA0;"
                    Percent="{x:Bind ViewModel.Gpu.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Gpu.SecondaryDetail, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Gpu.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="SYSTEM DISK"
                    AccentBrush="{ThemeResource DiskAccentBrush}"
                    Detail="{x:Bind ViewModel.Disk.Detail, Mode=OneWay}"
                    Glyph="&#xEDA2;"
                    Percent="{x:Bind ViewModel.Disk.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Disk.SecondaryDetail, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Disk.Value, Mode=OneWay}" />
            </controls:AdaptiveGridPanel>

            <!-- Charts -->
            <controls:AdaptiveGridPanel MinItemWidth="420">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardHeaderTextStyle}" Text="CPU usage" />
                            <ComboBox
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Chart time span"
                                ItemsSource="{x:Bind ViewModel.WindowOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
                        </Grid>
                        <controls:TimeSeriesChart
                            Grid.Row="1"
                            Height="180"
                            AutomationProperties.Name="CPU usage history"
                            Data="{x:Bind ViewModel.CpuChart, Mode=OneWay}"
                            Stroke="{ThemeResource CpuAccentBrush}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.CpuStats, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid MinHeight="32">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardHeaderTextStyle}" Text="Memory" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                        </Grid>
                        <controls:UsageBar
                            Grid.Row="1"
                            Foreground="{ThemeResource MemoryAccentBrush}"
                            Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" />
                        <controls:TimeSeriesChart
                            Grid.Row="2"
                            Height="164"
                            AutomationProperties.Name="Memory usage history"
                            Data="{x:Bind ViewModel.MemoryChart, Mode=OneWay}"
                            Stroke="{ThemeResource MemoryAccentBrush}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.MemoryStats, Mode=OneWay}" />
                    </Grid>
                </Border>
            </controls:AdaptiveGridPanel>

            <!-- Top processes and health -->
            <controls:AdaptiveGridPanel MinItemWidth="420">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Top applications" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.ProcessCountText, Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Sort top applications by"
                                SelectedIndex="{x:Bind ViewModel.TopSortIndex, Mode=TwoWay}">
                                <x:String>By CPU</x:String>
                                <x:String>By memory</x:String>
                            </ComboBox>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopProcessItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                            <TextBlock MaxWidth="220" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind InstancesText, Mode=OneWay}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <controls:UsageBar
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Value="{x:Bind Percent, Mode=OneWay}" />
                                        <StackPanel Grid.Column="2" MinWidth="110" HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind PrimaryText, Mode=OneWay}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" Text="{x:Bind SecondaryText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Grid.Row="2" Padding="0" Command="{x:Bind ViewModel.OpenProcessesCommand}" Content="View all processes" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel MinHeight="32">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="System health" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Technical indicators based on your alert thresholds" />
                        </StackPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HealthItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HealthItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:HealthGlyph VerticalAlignment="Top" Margin="0,2,0,0" Status="{x:Bind Status}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Grid.Row="2" Padding="0" Command="{x:Bind ViewModel.OpenPerformanceCommand}" Content="Open performance details" />
                    </Grid>
                </Border>
            </controls:AdaptiveGridPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
