<Page
    x:Class="PulseDesk.App.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PulseDesk.App.Controls"
    xmlns:vm="using:PulseDesk.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Changes" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="What changed on this PC recently" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="View"
                    ItemsSource="{x:Bind ViewModel.Views}"
                    SelectedIndex="{x:Bind ViewModel.ViewIndex, Mode=TwoWay}" />
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.CheckNowCommand}" ToolTipService.ToolTip="Take a snapshot of the PC now and compare it">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Check now" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Note, Mode=OneWay}" />
                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.SnapshotText, Mode=OneWay}" TextWrapping="Wrap" />
                <ProgressBar Margin="0,4,0,0" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChangeGroupViewModel">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind Title}" Visibility="{x:Bind HasTitle}" />
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChangeItemViewModel">
                                        <Expander Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid Padding="0,10" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Margin="0,2,0,0" VerticalAlignment="Top" FontSize="18" Glyph="{x:Bind Glyph}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Values}" TextWrapping="Wrap" Visibility="{x:Bind HasValues}" />
                                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind WhenText}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <controls:LevelBadge Grid.Column="2" VerticalAlignment="Top" BrushKey="{x:Bind ImportanceBrushKey}" Text="{x:Bind ImportanceText}" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Spacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="What it means" />
                                                    <TextBlock Text="{x:Bind Explanation}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Origin" />
                                                    <TextBlock Text="{x:Bind Origin}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Data used" />
                                                <ItemsControl ItemsSource="{x:Bind Evidence}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:EvidenceItemViewModel">
                                                            <Grid Padding="0,4" ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="180" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Metric}" TextWrapping="Wrap" />
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Observed}" TextWrapping="Wrap" />
                                                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Command="{x:Bind OpenCommand}" Content="{x:Bind ActionLabel}" Visibility="{x:Bind HasAction}" />
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Padding="24" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8AB;" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="No change to show" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="PulseDesk never invents a change: only differences between real snapshots are listed." TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="What is compared" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Installed applications (Apps &amp; features and Store apps), startup programs (Run keys and Startup folders), Windows build, BIOS version, installed memory, graphics and network adapters, fixed volumes and their used space, average CPU and memory usage, and programs that started running regularly. Snapshots are read-only and stay on this PC." />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Not covered: drivers, services, scheduled tasks and individual files." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
