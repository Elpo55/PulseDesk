<!--
    Sysora color palette. The only place where colors are defined: controls and pages refer to these
    keys (with {ThemeResource}) or to the standard Fluent brushes, never to literal colors.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Metric accents (charts, bars, card icons) -->
            <SolidColorBrush x:Key="CpuAccentBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="MemoryAccentBrush" Color="#8764B8" />
            <SolidColorBrush x:Key="GpuAccentBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="DiskAccentBrush" Color="#CA5010" />
            <SolidColorBrush x:Key="NetworkAccentBrush" Color="#038387" />
            <SolidColorBrush x:Key="NetworkSecondaryAccentBrush" Color="#B4009E" />

            <!-- Health status -->
            <SolidColorBrush x:Key="StatusNormalBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#0067C0" />

            <!-- Impact levels (App Impact) -->
            <SolidColorBrush x:Key="LevelLowBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="LevelModerateBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="LevelHighBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="LevelVeryHighBrush" Color="#C42B1C" />

            <!-- Charts -->
            <SolidColorBrush x:Key="ChartGridBrush" Color="#14000000" />
            <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#06000000" />

            <!-- Demo mode badge -->
            <SolidColorBrush x:Key="DemoBadgeBackgroundBrush" Color="#FFF4CE" />
            <SolidColorBrush x:Key="DemoBadgeForegroundBrush" Color="#5C3B00" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CpuAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="MemoryAccentBrush" Color="#B696F0" />
            <SolidColorBrush x:Key="GpuAccentBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="DiskAccentBrush" Color="#F7A35C" />
            <SolidColorBrush x:Key="NetworkAccentBrush" Color="#4FD1D5" />
            <SolidColorBrush x:Key="NetworkSecondaryAccentBrush" Color="#E37CD3" />

            <SolidColorBrush x:Key="StatusNormalBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#9D9D9D" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#4CC2FF" />

            <SolidColorBrush x:Key="LevelLowBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="LevelModerateBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="LevelHighBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="LevelVeryHighBrush" Color="#FF99A4" />

            <SolidColorBrush x:Key="ChartGridBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#08FFFFFF" />

            <SolidColorBrush x:Key="DemoBadgeBackgroundBrush" Color="#433519" />
            <SolidColorBrush x:Key="DemoBadgeForegroundBrush" Color="#FCE100" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CpuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MemoryAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GpuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DiskAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NetworkAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NetworkSecondaryAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <SolidColorBrush x:Key="StatusNormalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="LevelLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LevelModerateBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LevelHighBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LevelVeryHighBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="ChartGridBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ChartBackgroundBrush" Color="Transparent" />

            <SolidColorBrush x:Key="DemoBadgeBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DemoBadgeForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
