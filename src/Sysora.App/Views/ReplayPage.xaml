<Page
    x:Class="Sysora.App.Views.ReplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="ReplayChartStyle" TargetType="controls:TimeSeriesChart">
            <Setter Property="Height" Value="150" />
            <Setter Property="IsTimeSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <!-- Adaptive states must be attached to the page's root element to be evaluated. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SideColumn.Width" Value="340" />
                        <Setter Target="SidePanel.(Grid.Row)" Value="3" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="1" />
                        <Setter Target="SidePanel.(Grid.RowSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer>
            <Grid
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="{StaticResource PagePadding}"
                ColumnSpacing="16"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_Replay}" />
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.Replay_WhatHappenedOnYourPCInTheLastMinutesOrHours}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.BackToNowCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="{x:Bind l:UiStrings.Replay_BackToNow}" />
                        </StackPanel>
                    </Button>
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind l:UiStrings.Common_Period}"
                        ItemsSource="{x:Bind ViewModel.Ranges}"
                        SelectedItem="{x:Bind ViewModel.Range, Mode=TwoWay}" />
                    <Button Grid.Column="3" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind l:UiStrings.Replay_ZoomIn}" Command="{x:Bind ViewModel.ZoomInCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Replay_ZoomInShorterPeriodAroundTheCursor}">
                        <FontIcon FontSize="14" Glyph="&#xE8A3;" />
                    </Button>
                    <Button Grid.Column="4" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind l:UiStrings.Replay_ZoomOut}" Command="{x:Bind ViewModel.ZoomOutCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Replay_ZoomOutLongerPeriod}">
                        <FontIcon FontSize="14" Glyph="&#xE71F;" />
                    </Button>
                    <Button Grid.Column="5" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind l:UiStrings.Replay_CompareBeforeAndAfterTheCursor}" Command="{x:Bind ViewModel.CompareAroundCursorCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Replay_CompareThe15MinutesBeforeAndAfterTheCursor}">
                        <FontIcon FontSize="14" Glyph="&#xE81E;" />
                    </Button>
                    <Button Grid.Column="6" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind l:UiStrings.Common_Export}" Command="{x:Bind ViewModel.ExportCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Replay_SaveThisPeriodAsAnHTMLReportOrJSONData}">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                    </Button>
                </Grid>

                <!-- What happened -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_WhatHappened}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Moments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MomentItemViewModel">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:StatusIcon VerticalAlignment="Center" BrushKey="{x:Bind BrushKey, Mode=OneWay}" Glyph="{x:Bind Glyph, Mode=OneWay}" GlyphSize="12" />
                                        <HyperlinkButton Grid.Column="1" Padding="4,2" Content="{x:Bind TimeText, Mode=OneWay}" Command="{x:Bind SelectCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Replay_MoveTheCursorToThisMoment}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Timeline slider -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16,8" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_Timeline}" />
                        <Slider
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind l:UiStrings.Replay_ReplayPosition}"
                            IsThumbToolTipEnabled="False"
                            Maximum="{x:Bind ViewModel.SliderMaximumValue}"
                            Minimum="0"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.SliderPosition, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Charts -->
                <controls:AdaptiveGridPanel Grid.Row="3" MaxColumns="2" MinItemWidth="340">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_CPU}" />
                            <controls:TimeSeriesChart
                                AutomationProperties.Name="{x:Bind l:UiStrings.Replay_CPUUsageReplay}"
                                CursorTime="{x:Bind ViewModel.CursorTime, Mode=OneWay}"
                                Data="{x:Bind ViewModel.CpuChart, Mode=OneWay}"
                                Markers="{x:Bind ViewModel.EventTimes, Mode=OneWay}"
                                Stroke="{ThemeResource CpuAccentBrush}"
                                Style="{StaticResource ReplayChartStyle}"
                                TimeSelected="OnTimeSelected" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_Memory}" />
                            <controls:TimeSeriesChart
                                AutomationProperties.Name="{x:Bind l:UiStrings.Replay_MemoryUsageReplay}"
                                CursorTime="{x:Bind ViewModel.CursorTime, Mode=OneWay}"
                                Data="{x:Bind ViewModel.MemoryChart, Mode=OneWay}"
                                Markers="{x:Bind ViewModel.EventTimes, Mode=OneWay}"
                                Stroke="{ThemeResource MemoryAccentBrush}"
                                Style="{StaticResource ReplayChartStyle}"
                                TimeSelected="OnTimeSelected" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasDisk, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Replay_DiskBusiestVolumeActiveTime}" />
                            <controls:TimeSeriesChart
                                AutomationProperties.Name="{x:Bind l:UiStrings.Replay_DiskActivityReplay}"
                                CursorTime="{x:Bind ViewModel.CursorTime, Mode=OneWay}"
                                Data="{x:Bind ViewModel.DiskChart, Mode=OneWay}"
                                Markers="{x:Bind ViewModel.EventTimes, Mode=OneWay}"
                                Stroke="{ThemeResource DiskAccentBrush}"
                                Style="{StaticResource ReplayChartStyle}"
                                TimeSelected="OnTimeSelected" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNetwork, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Replay_NetworkDownloadAndUpload}" />
                            <controls:TimeSeriesChart
                                AutomationProperties.Name="{x:Bind l:UiStrings.Replay_NetworkReplay}"
                                CursorTime="{x:Bind ViewModel.CursorTime, Mode=OneWay}"
                                Data="{x:Bind ViewModel.NetworkChart, Mode=OneWay}"
                                Markers="{x:Bind ViewModel.EventTimes, Mode=OneWay}"
                                SecondaryStroke="{ThemeResource NetworkSecondaryAccentBrush}"
                                Stroke="{ThemeResource NetworkAccentBrush}"
                                Style="{StaticResource ReplayChartStyle}"
                                TimeSelected="OnTimeSelected" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasGpu, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Replay_GPUBusiestAdapter}" />
                            <controls:TimeSeriesChart
                                AutomationProperties.Name="{x:Bind l:UiStrings.Replay_GPUUsageReplay}"
                                CursorTime="{x:Bind ViewModel.CursorTime, Mode=OneWay}"
                                Data="{x:Bind ViewModel.GpuChart, Mode=OneWay}"
                                Markers="{x:Bind ViewModel.EventTimes, Mode=OneWay}"
                                Stroke="{ThemeResource GpuAccentBrush}"
                                Style="{StaticResource ReplayChartStyle}"
                                TimeSelected="OnTimeSelected" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveGridPanel>

                <!-- Values at the cursor -->
                <Border x:Name="SidePanel" Grid.Row="4" VerticalAlignment="Top" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Replay_AtTheCursor}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CursorTimeText, Mode=OneWay}" />
                        </StackPanel>
                        <controls:AdaptiveGridPanel MinItemWidth="140" RowSpacing="10">
                            <controls:StatItem Label="{x:Bind l:UiStrings.Common_CPU}" Value="{x:Bind ViewModel.CursorCpu, Mode=OneWay}" />
                            <controls:StatItem Label="{x:Bind l:UiStrings.Common_Memory}" Value="{x:Bind ViewModel.CursorMemory, Mode=OneWay}" />
                            <controls:StatItem Label="{x:Bind l:UiStrings.Replay_Disk}" Value="{x:Bind ViewModel.CursorDisk, Mode=OneWay}" />
                            <controls:StatItem Label="{x:Bind l:UiStrings.Common_GPU}" Value="{x:Bind ViewModel.CursorGpu, Mode=OneWay}" />
                            <controls:StatItem Label="{x:Bind l:UiStrings.Common_Network}" Value="{x:Bind ViewModel.CursorNetwork, Mode=OneWay}" />
                            <controls:StatItem Label="{x:Bind l:UiStrings.Common_Processes}" Value="{x:Bind ViewModel.CursorProcesses, Mode=OneWay}" />
                        </controls:AdaptiveGridPanel>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Replay_Applications}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CursorApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Padding="0,2" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Replay_EventsAroundThisTime}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CursorEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Padding="0,2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Grid.ColumnSpan="2" Padding="24" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind l:UiStrings.Replay_NoMeasurementsForThisPeriodLongerPeriodsUseThe}" TextAlignment="Center" />
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
