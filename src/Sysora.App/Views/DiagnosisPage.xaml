<Page
    x:Class="Sysora.App.Views.DiagnosisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- One finding: a headline that is always visible, details on demand. -->
        <DataTemplate x:Key="DiagnosisItemTemplate" x:DataType="vm:DiagnosisItemViewModel">
            <Expander
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:StatusIcon Margin="0,2,0,0" VerticalAlignment="Top" BrushKey="{x:Bind BrushKey, Mode=OneWay}" Glyph="{x:Bind Glyph, Mode=OneWay}" GlyphSize="18" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Observed, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_WhyItMatters}" />
                        <TextBlock Text="{x:Bind Explanation, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2" Visibility="{x:Bind HasRecommendation, Mode=OneWay}">
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_WhatYouCanDo}" />
                        <TextBlock Text="{x:Bind Recommendation, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Reference, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ConfidenceText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind TimeText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_DataUsed}" />
                    <ItemsControl ItemsSource="{x:Bind Evidence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EvidenceItemViewModel">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Metric}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Observed}" TextWrapping="Wrap" />
                                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind WhyNowCommand}" Content="{x:Bind l:UiStrings.Common_WhyNow}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Diagnosis_WhenDidItStartWhatChangedAtTheSameTimeAndHow}" Visibility="{x:Bind CanExplainWhyNow, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind OpenCommand}"
                            Content="{x:Bind ActionLabel, Mode=OneWay}"
                            Visibility="{x:Bind HasAction, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_Diagnosis}" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_WhyIsMyPCSlowSysoraChecksWhatItMeasuresAnd}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.Name="{x:Bind l:UiStrings.Diagnosis_AnalyzeAgain}" Command="{x:Bind ViewModel.RunCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="{x:Bind l:UiStrings.Diagnosis_AnalyzeAgain}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{x:Bind l:UiStrings.Common_Export}" Command="{x:Bind ViewModel.ExportCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Diagnosis_SaveTheDiagnosisAsAnHTMLReportOrJSONData}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                            <TextBlock Text="{x:Bind l:UiStrings.Common_Export}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Overall answer -->
            <Border Padding="20" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:StatusIcon VerticalAlignment="Top" BrushKey="{x:Bind ViewModel.StateBrushKey, Mode=OneWay}" Glyph="{x:Bind ViewModel.StateGlyph, Mode=OneWay}" GlyphSize="32" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Headline, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.AnalyzedText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.BaselineText, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Why now? -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_WhyNow}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_WhenAProblemStartedFromWhatLevelWhatChangedAtThe}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind l:UiStrings.Diagnosis_MetricToExplain}" ItemsSource="{x:Bind ViewModel.WhyNowMetrics}" SelectedIndex="{x:Bind ViewModel.WhyNowIndex, Mode=TwoWay}" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.AnalyzeWhyNowCommand}" Content="{x:Bind l:UiStrings.Diagnosis_Explain}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="3" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind l:UiStrings.Diagnosis_ExportThisExplanation}" Command="{x:Bind ViewModel.ExportWhyNowCommand}" IsEnabled="{x:Bind ViewModel.HasWhyNow, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Diagnosis_ExportThisExplanation}">
                            <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                        </Button>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsWhyNowRunning, Mode=OneWay}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasWhyNow, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.WhyNowHeadline, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.WhyNowSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        <controls:AdaptiveGridPanel MinItemWidth="200" RowSpacing="8" Visibility="{x:Bind ViewModel.IsWhyNowSignificant, Mode=OneWay}">
                            <controls:StatItem Label="{x:Bind l:UiStrings.Common_Started}" Value="{x:Bind ViewModel.WhyNowStarted, Mode=OneWay}" />
                            <controls:StatItem Label="{x:Bind l:UiStrings.Diagnosis_BeforeNow}" Value="{x:Bind ViewModel.WhyNowChange, Mode=OneWay}" />
                            <controls:StatItem Label="{x:Bind l:UiStrings.Common_Duration}" Value="{x:Bind ViewModel.WhyNowDuration, Mode=OneWay}" />
                        </controls:AdaptiveGridPanel>
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.IsWhyNowSignificant, Mode=OneWay}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_MainContributor}" />
                            <TextBlock Text="{x:Bind ViewModel.WhyNowContributor, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.WhyNowUsual, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.WhyNowSimilar, Mode=OneWay}" />
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasWhyNowEvents, Mode=OneWay}">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_AtTheSameTimeACoincidenceInTimeIsNotProofOfCause}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.WhyNowEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Padding="0,2" Text="{x:Bind}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <HyperlinkButton Padding="0" Command="{x:Bind ViewModel.OpenTimelineCommand}" Content="{x:Bind l:UiStrings.Diagnosis_SeeEverythingThatHappenedAroundItInTheTimeline}" />
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{x:Bind l:UiStrings.Diagnosis_EveryStatementAndWhatItRestsOn}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.WhyNowFindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FindingItemViewModel">
                                        <Grid Padding="0,3" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:LevelBadge VerticalAlignment="Top" BrushKey="{x:Bind BasisBrushKey}" Text="{x:Bind BasisText}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Text="{x:Bind Label}" /><Run Text=": " /><Run Text="{x:Bind Text}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recurring problems (details on PC Health) -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE823;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind l:UiStrings.Common_RecurringProblems}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.RecurringText, Mode=OneWay}" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenRecurringCommand}" Content="{x:Bind l:UiStrings.Diagnosis_OpenPCHealth}" />
                </Grid>
            </Border>

            <!-- Compared with the history -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_ComparedWithYourUsualActivity}" />
                    <TextBlock Text="{x:Bind ViewModel.ComparisonSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" Visibility="{x:Bind ViewModel.HasComparisonRows, Mode=OneWay}">
                        <StackPanel MinWidth="720">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_Metric}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_Now}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Diagnosis_AverageOfTheLast15Minutes}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_LastHour}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_Today}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_Yesterday}" />
                                <TextBlock Grid.Column="5" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_7Days}" />
                                <TextBlock Grid.Column="6" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_30Days}" />
                                <TextBlock Grid.Column="7" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_UsualAtThisHour}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Diagnosis_SameHourOfTheDayOverTheLast30DaysTodayExcluded}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ComparisonRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ComparisonRowViewModel">
                                        <Grid Padding="0,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Now.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Now.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind LastHour.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind LastHour.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Today.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Today.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Yesterday.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Yesterday.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Last7Days.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Last7Days.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind Last30Days.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Last30Days.Tooltip, Mode=OneWay}" />
                                            <TextBlock Grid.Column="7" Text="{x:Bind Usual.Text, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Usual.Tooltip, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_AveragesOfTheLocalHistoryAPeriodWithoutEnough}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Problems detected -->
            <StackPanel Spacing="0" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_ProblemsDetected}" />
                <ItemsControl ItemTemplate="{StaticResource DiagnosisItemTemplate}" ItemsSource="{x:Bind ViewModel.Problems}" />
            </StackPanel>

            <!-- Recommendations -->
            <StackPanel Visibility="{x:Bind ViewModel.HasRecommendations, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_Recommendations}" />
                <Border Style="{StaticResource CardStyle}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid Padding="0,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Margin="0,3,0,0" VerticalAlignment="Top" FontSize="12" Glyph="&#xE76C;" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Potential issues -->
            <StackPanel Visibility="{x:Bind ViewModel.HasPotential, Mode=OneWay}">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_PointsToWatch}" />
                <ItemsControl ItemTemplate="{StaticResource DiagnosisItemTemplate}" ItemsSource="{x:Bind ViewModel.Potential}" />
            </StackPanel>

            <!-- Normal -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_CheckedAndNormal}" />
                <ItemsControl ItemTemplate="{StaticResource DiagnosisItemTemplate}" ItemsSource="{x:Bind ViewModel.NormalItems}" />
            </StackPanel>

            <!-- Not analyzed -->
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_NotAnalyzed}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NotAnalyzed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Padding="0,2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Diagnosis_SysoraOnlyReportsWhatItMeasuresRulesAre}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
