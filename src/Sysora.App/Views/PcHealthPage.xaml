<Page
    x:Class="Sysora.App.Views.PcHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="FindingTemplate" x:DataType="vm:FindingItemViewModel">
            <Grid Padding="0,3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:LevelBadge VerticalAlignment="Top" BrushKey="{x:Bind BasisBrushKey}" Text="{x:Bind BasisText}" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="{x:Bind Label}" /><Run Text=": " /><Run Text="{x:Bind Text}" />
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_PCHealth}" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.PcHealth_InWhatStateIsMyPCAScoreOutOf100ExplainedAreaBy}" TextWrapping="Wrap" />
                </StackPanel>
                <Button AutomationProperties.Name="{x:Bind l:UiStrings.Common_Refresh}" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="{x:Bind l:UiStrings.Common_Refresh}" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{x:Bind l:UiStrings.Common_Export}" Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.ExportCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.PcHealth_SaveThisAnalysisAsAnHTMLReportOrJSONData}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                        <TextBlock Text="{x:Bind l:UiStrings.Common_Export}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Score -->
            <Border Padding="20" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="120" Height="120">
                        <ProgressRing
                            Width="120"
                            Height="120"
                            AutomationProperties.Name="{x:Bind l:UiStrings.PcHealth_PCHealthScore}"
                            IsIndeterminate="False"
                            Maximum="100"
                            Value="{x:Bind ViewModel.ScoreValue, Mode=OneWay}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontSize="36" FontWeight="SemiBold" Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.PcHealth_OutOf100}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:StatusIcon VerticalAlignment="Center" BrushKey="{x:Bind ViewModel.GradeBrushKey, Mode=OneWay}" Glyph="{x:Bind ViewModel.GradeGlyph, Mode=OneWay}" GlyphSize="20" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.GradeText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Areas -->
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.PcHealth_Areas}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthComponentItemViewModel">
                        <Expander
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Margin="0,2,0,0" VerticalAlignment="Top" FontSize="18" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Summary, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Spacing="4">
                                        <controls:LevelBadge HorizontalAlignment="Right" BrushKey="{x:Bind BrushKey, Mode=OneWay}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ImpactText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.PcHealth_WhyThisImpact}" />
                                    <TextBlock Text="{x:Bind Explanation, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_DataUsed}" Visibility="{x:Bind HasEvidence, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EvidenceItemViewModel">
                                            <Grid Padding="0,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Metric}" TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Observed}" TextWrapping="Wrap" />
                                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{x:Bind OpenCommand}" Content="{x:Bind ActionLabel, Mode=OneWay}" Visibility="{x:Bind HasAction, Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recurring problems -->
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_RecurringProblems}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.RecurringSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Recurring}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecurringItemViewModel">
                                <StackPanel Margin="0,6,0,6" Spacing="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description}" />
                                        </StackPanel>
                                        <controls:LevelBadge Grid.Column="1" VerticalAlignment="Top" BrushKey="{x:Bind ConfidenceBrushKey}" Text="{x:Bind ConfidenceText}" />
                                    </Grid>
                                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{x:Bind Findings}" />
                                    <HyperlinkButton Padding="0" Command="{x:Bind OpenCommand}" Content="{x:Bind ActionLabel}" Visibility="{x:Bind HasAction}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.PcHealth_AProblemIsCalledRecurringAfter3EpisodesOn2}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Sysora's own impact -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE9D9;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelfImpactHeadline, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.SelfImpactText, Mode=OneWay}" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenSettingsCommand}" Content="{x:Bind l:UiStrings.PcHealth_DetailsAndIntensity}" />
                </Grid>
            </Border>

            <!-- Method -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind l:UiStrings.PcHealth_HowTheScoreIsComputed}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Method}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind l:UiStrings.PcHealth_NotCounted}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NotAvailable}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Padding="0,2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
