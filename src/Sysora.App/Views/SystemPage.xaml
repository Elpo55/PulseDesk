<Page
    x:Class="Sysora.App.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sysora.App.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="InfoCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
            <Setter Property="CharacterSpacing" Value="40" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="System" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Only information Windows actually reports is shown" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Read hardware information again"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Read hardware information again">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Uptime -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="28" Foreground="{ThemeResource CpuAccentBrush}" Glyph="&#xE917;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="SYSTEM UPTIME" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.UptimeLong, Mode=OneWay}" />
                    </StackPanel>
                    <controls:StatItem Grid.Column="2" Label="Last start" Value="{x:Bind ViewModel.BootTime, Mode=OneWay}" Hint="With Fast Startup, shutting down and turning on again does not restart this counter: only Restart does." />
                </Grid>
            </Border>

            <controls:AdaptiveGridPanel MinItemWidth="360">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE770;" />
                            <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="WINDOWS" />
                        </StackPanel>
                        <controls:StatItem Label="Edition" Value="{x:Bind ViewModel.Windows, Mode=OneWay}" />
                        <controls:StatItem Label="Version" Value="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}" />
                        <controls:StatItem Label="Installed on" Value="{x:Bind ViewModel.InstalledOn, Mode=OneWay}" />
                        <controls:StatItem Label="Architecture" Value="{x:Bind ViewModel.Architecture, Mode=OneWay}" />
                        <controls:StatItem Label="Computer name" Value="{x:Bind ViewModel.ComputerName, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE950;" />
                            <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="HARDWARE" />
                        </StackPanel>
                        <controls:StatItem Label="Processor" Value="{x:Bind ViewModel.Processor, Mode=OneWay}" />
                        <TextBlock Margin="0,-10,0,0" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.ProcessorDetails, Mode=OneWay}" />
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Graphics" />
                            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Graphics, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:StatItem Label="Memory" Value="{x:Bind ViewModel.Memory, Mode=OneWay}" />
                        <TextBlock Margin="0,-10,0,0" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.MemoryDetails, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE7F8;" />
                            <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="FIRMWARE" />
                        </StackPanel>
                        <controls:StatItem Label="System model" Value="{x:Bind ViewModel.SystemModel, Mode=OneWay}" />
                        <controls:StatItem Label="Motherboard" Value="{x:Bind ViewModel.Motherboard, Mode=OneWay}" />
                        <controls:StatItem Label="BIOS" Value="{x:Bind ViewModel.Bios, Mode=OneWay}" />
                        <controls:StatItem Label="BIOS date" Value="{x:Bind ViewModel.BiosDate, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </controls:AdaptiveGridPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
