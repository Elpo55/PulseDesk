<Page
    x:Class="Sysora.App.Views.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="InfoCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
            <Setter Property="CharacterSpacing" Value="40" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_System}" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.System_OnlyInformationWindowsActuallyReportsIsShown}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind l:UiStrings.System_ReadHardwareInformationAgain}"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="{x:Bind l:UiStrings.System_ReadHardwareInformationAgain}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Uptime -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="28" Foreground="{ThemeResource CpuAccentBrush}" Glyph="&#xE917;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="{x:Bind l:UiStrings.System_SYSTEMUPTIME}" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.UptimeLong, Mode=OneWay}" />
                    </StackPanel>
                    <controls:StatItem Grid.Column="2" Label="{x:Bind l:UiStrings.System_LastStart}" Value="{x:Bind ViewModel.BootTime, Mode=OneWay}" Hint="{x:Bind l:UiStrings.System_WithFastStartupShuttingDownAndTurningOnAgainDoes}" />
                </Grid>
            </Border>

            <controls:AdaptiveGridPanel MinItemWidth="360">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE770;" />
                            <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="{x:Bind l:UiStrings.System_WINDOWS}" />
                        </StackPanel>
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_Edition}" Value="{x:Bind ViewModel.Windows, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Common_Version}" Value="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_InstalledOn}" Value="{x:Bind ViewModel.InstalledOn, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_Architecture}" Value="{x:Bind ViewModel.Architecture, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_ComputerName}" Value="{x:Bind ViewModel.ComputerName, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE950;" />
                            <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="{x:Bind l:UiStrings.System_HARDWARE}" />
                        </StackPanel>
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_Processor}" Value="{x:Bind ViewModel.Processor, Mode=OneWay}" />
                        <TextBlock Margin="0,-10,0,0" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.ProcessorDetails, Mode=OneWay}" />
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.System_Graphics}" />
                            <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Graphics, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:StatItem Label="{x:Bind l:UiStrings.Common_Memory}" Value="{x:Bind ViewModel.Memory, Mode=OneWay}" />
                        <TextBlock Margin="0,-10,0,0" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.MemoryDetails, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE7F8;" />
                            <TextBlock Style="{StaticResource InfoCardTitleStyle}" Text="{x:Bind l:UiStrings.System_FIRMWARE}" />
                        </StackPanel>
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_SystemModel}" Value="{x:Bind ViewModel.SystemModel, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_Motherboard}" Value="{x:Bind ViewModel.Motherboard, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_BIOS}" Value="{x:Bind ViewModel.Bios, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.System_BIOSDate}" Value="{x:Bind ViewModel.BiosDate, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </controls:AdaptiveGridPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
