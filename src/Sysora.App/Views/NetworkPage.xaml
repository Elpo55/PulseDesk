<Page
    x:Class="Sysora.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_Network}" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.Network_LocalStatisticsOnlySysoraSendsNoNetworkTrafficTo}" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind l:UiStrings.Common_ChartTimeSpan}"
                    Header="{x:Bind l:UiStrings.Common_TimeSpan}"
                    ItemsSource="{x:Bind ViewModel.WindowOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsDisabled, Mode=OneWay}"
                Message="{x:Bind l:UiStrings.Network_NetworkMonitoringIsTurnedOffInSettings}"
                Severity="Informational" />

            <controls:AdaptiveGridPanel MinItemWidth="220">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock CharacterSpacing="40" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Network_CONNECTION}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:HealthGlyph Status="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ConnectionDetail, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <controls:MetricCard
                    Title="{x:Bind l:UiStrings.Network_DownloadHeader}"
                    AccentBrush="{ThemeResource NetworkAccentBrush}"
                    Detail="Receive rate"
                    Glyph="&#xE896;"
                    Value="{x:Bind ViewModel.Download, Mode=OneWay}" />
                <controls:MetricCard
                    Title="{x:Bind l:UiStrings.Network_UploadHeader}"
                    AccentBrush="{ThemeResource NetworkSecondaryAccentBrush}"
                    Detail="Send rate"
                    Glyph="&#xE898;"
                    Value="{x:Bind ViewModel.Upload, Mode=OneWay}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock CharacterSpacing="40" Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Network_ACTIVEINTERFACE}" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.PrimaryName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.PrimaryAddress, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </controls:AdaptiveGridPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Network_Throughput}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="3" VerticalAlignment="Center" Fill="{ThemeResource NetworkAccentBrush}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Network_Download}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="3" VerticalAlignment="Center" Fill="{ThemeResource NetworkSecondaryAccentBrush}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Network_Upload}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <controls:TimeSeriesChart
                        Grid.Row="1"
                        Height="220"
                        AutomationProperties.Name="{x:Bind l:UiStrings.Network_NetworkThroughputHistory}"
                        Data="{x:Bind ViewModel.Chart, Mode=OneWay}"
                        SecondaryStroke="{ThemeResource NetworkSecondaryAccentBrush}"
                        Stroke="{ThemeResource NetworkAccentBrush}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind l:UiStrings.Network_Interfaces}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Interfaces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:AdaptiveGridPanel MinItemWidth="380" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkInterfaceItemViewModel">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="24" Foreground="{ThemeResource NetworkAccentBrush}" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind Name, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Description, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Kind, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <controls:AdaptiveGridPanel MinItemWidth="140" RowSpacing="12">
                                    <controls:StatItem Label="{x:Bind l:UiStrings.Network_Download}" Value="{x:Bind Receive, Mode=OneWay}" />
                                    <controls:StatItem Label="{x:Bind l:UiStrings.Network_Upload}" Value="{x:Bind Send, Mode=OneWay}" />
                                    <controls:StatItem Label="{x:Bind l:UiStrings.Network_LinkSpeed}" Value="{x:Bind Speed, Mode=OneWay}" />
                                    <controls:StatItem Label="{x:Bind l:UiStrings.Network_Received}" Value="{x:Bind Received, Mode=OneWay}" Hint="{x:Bind l:UiStrings.Network_SinceTheInterfaceCameUp}" />
                                    <controls:StatItem Label="{x:Bind l:UiStrings.Network_Sent}" Value="{x:Bind Sent, Mode=OneWay}" Hint="{x:Bind l:UiStrings.Network_SinceTheInterfaceCameUp}" />
                                    <controls:StatItem Label="{x:Bind l:UiStrings.Network_IPv4}" Value="{x:Bind IPv4, Mode=OneWay}" />
                                </controls:AdaptiveGridPanel>
                                <controls:StatItem Label="{x:Bind l:UiStrings.Network_IPv6}" Value="{x:Bind IPv6, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind l:UiStrings.Network_LatencyIsNotMeasuredItWouldRequireContactingA}" />
        </StackPanel>
    </ScrollViewer>
</Page>
