<Page
    x:Class="Sysora.App.Views.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.Name="Export" Grid.Column="3" VerticalAlignment="Center" Command="{x:Bind ViewModel.ExportCommand}" ToolTipService.ToolTip="Save the alerts as an HTML report or JSON data">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Alerts" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Problems that last or are unusual for this PC. Short spikes are never reported." TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    MinWidth="130"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Show"
                    ItemsSource="{x:Bind ViewModel.Filters}"
                    SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" />
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.MarkAllSeenCommand}" Content="Mark all as seen" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsDisabled, Mode=OneWay}"
                Message="Alerts are turned off in Settings."
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.OpenSettingsCommand}" Content="Open Settings" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertItemViewModel">
                        <Expander
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:StatusIcon Margin="0,2,0,0" VerticalAlignment="Top" BrushKey="{x:Bind BrushKey, Mode=OneWay}" Glyph="{x:Bind Glyph, Mode=OneWay}" GlyphSize="18" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Observed, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind TimeText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <controls:LevelBadge Grid.Column="2" VerticalAlignment="Top" BrushKey="{x:Bind StatusBrushKey, Mode=OneWay}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Context" />
                                    <TextBlock Text="{x:Bind ContextText, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Why this alert" />
                                    <TextBlock Text="{x:Bind Explanation, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="2" Visibility="{x:Bind HasRecommendation, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="What you can do" />
                                    <TextBlock Text="{x:Bind Recommendation, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Data used" />
                                <ItemsControl ItemsSource="{x:Bind Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EvidenceItemViewModel">
                                            <Grid Padding="0,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Metric}" TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Observed}" TextWrapping="Wrap" />
                                                    <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ReplayCommand}" Content="Show in Replay" ToolTipService.ToolTip="What happened around this alert" />
                                    <Button Command="{x:Bind WhyNowCommand}" Content="Why now?" Visibility="{x:Bind CanExplainWhyNow, Mode=OneWay}" />
                                    <Button Command="{x:Bind OpenCommand}" Content="{x:Bind ActionLabel, Mode=OneWay}" Visibility="{x:Bind HasAction, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Padding="24" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon FontSize="32" Foreground="{ThemeResource StatusNormalBrush}" Glyph="&#xE73E;" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nothing to report" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Sysora raises an alert only when a problem lasts or is unusual for this PC." TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Active rules" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.RulesText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="A condition must last before it is reported; while it lasts it updates a single alert, which resolves one minute after the condition ends. If it comes back soon after, the same alert reopens. At most a few new alerts are raised per hour." />
                    <HyperlinkButton Padding="0" Command="{x:Bind ViewModel.OpenSettingsCommand}" Content="Change the rules in Settings" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
