<Page
    x:Class="Sysora.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <!-- Header: how is my PC? -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Dashboard" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Padding="14,8"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="PC status, open the diagnosis"
                    Command="{x:Bind ViewModel.OpenDiagnosisCommand}"
                    CornerRadius="18"
                    ToolTipService.ToolTip="Open the diagnosis">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:StatusIcon VerticalAlignment="Center" BrushKey="{x:Bind ViewModel.StatusBrushKey, Mode=OneWay}" Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" GlyphSize="18" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Performance -->
            <controls:AdaptiveGridPanel MinItemWidth="200">
                <controls:MetricCard
                    Title="CPU"
                    AccentBrush="{ThemeResource CpuAccentBrush}"
                    Detail="{x:Bind ViewModel.Cpu.Detail, Mode=OneWay}"
                    Glyph="&#xE950;"
                    Percent="{x:Bind ViewModel.Cpu.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Cpu.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.CpuSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Cpu.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="MEMORY"
                    AccentBrush="{ThemeResource MemoryAccentBrush}"
                    Detail="{x:Bind ViewModel.Memory.Detail, Mode=OneWay}"
                    Glyph="&#xE964;"
                    Percent="{x:Bind ViewModel.Memory.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Memory.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.MemorySpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Memory.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="GPU"
                    AccentBrush="{ThemeResource GpuAccentBrush}"
                    Detail="{x:Bind ViewModel.Gpu.Detail, Mode=OneWay}"
                    Glyph="&#xEEA0;"
                    Percent="{x:Bind ViewModel.Gpu.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Gpu.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.GpuSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Gpu.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="SYSTEM DISK"
                    AccentBrush="{ThemeResource DiskAccentBrush}"
                    Detail="{x:Bind ViewModel.Disk.Detail, Mode=OneWay}"
                    Glyph="&#xEDA2;"
                    Percent="{x:Bind ViewModel.Disk.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Disk.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.DiskSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Disk.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="NETWORK"
                    AccentBrush="{ThemeResource NetworkAccentBrush}"
                    Detail="{x:Bind ViewModel.Network.Detail, Mode=OneWay}"
                    Glyph="&#xE968;"
                    Percent="{x:Bind ViewModel.Network.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Network.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.NetworkSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Network.Value, Mode=OneWay}" />
            </controls:AdaptiveGridPanel>

            <!-- Insights and quick actions -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Insights" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Insights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InsightItemViewModel">
                                    <Grid Padding="0,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:StatusIcon Margin="0,2,0,0" VerticalAlignment="Top" BrushKey="{x:Bind BrushKey, Mode=OneWay}" Glyph="{x:Bind Glyph, Mode=OneWay}" GlyphSize="14" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="2"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Details"
                                            Command="{x:Bind OpenCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Details"
                                            Visibility="{x:Bind HasAction, Mode=OneWay}">
                                            <FontIcon FontSize="12" Glyph="&#xE76C;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" MinWidth="220" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Quick actions" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenDiagnosisCommand}" ToolTipService.ToolTip="Why is my PC slow?">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE95E;" />
                                <TextBlock Text="Diagnose" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenReplayCommand}" ToolTipService.ToolTip="What happened in the last minutes?">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE81C;" />
                                <TextBlock Text="Replay" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenChangesCommand}" ToolTipService.ToolTip="What changed recently?">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE8AB;" />
                                <TextBlock Text="View changes" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenAppImpactCommand}" ToolTipService.ToolTip="Which application weighs the most?">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE9F9;" />
                                <TextBlock Text="App impact" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenAlertsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                                <TextBlock Text="{x:Bind ViewModel.AlertsText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenGamingCommand}" ToolTipService.ToolTip="Recaps of your game sessions">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE7FC;" />
                                <TextBlock MaxWidth="180" Text="{x:Bind ViewModel.GamingText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts -->
            <controls:AdaptiveGridPanel MinItemWidth="420">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardHeaderTextStyle}" Text="CPU usage" />
                            <ComboBox
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Chart time span"
                                ItemsSource="{x:Bind ViewModel.WindowOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
                        </Grid>
                        <controls:TimeSeriesChart
                            Grid.Row="1"
                            Height="180"
                            AutomationProperties.Name="CPU usage history"
                            Data="{x:Bind ViewModel.CpuChart, Mode=OneWay}"
                            Stroke="{ThemeResource CpuAccentBrush}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.CpuStats, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid MinHeight="32">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardHeaderTextStyle}" Text="Memory" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                        </Grid>
                        <controls:UsageBar
                            Grid.Row="1"
                            Foreground="{ThemeResource MemoryAccentBrush}"
                            Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" />
                        <controls:TimeSeriesChart
                            Grid.Row="2"
                            Height="164"
                            AutomationProperties.Name="Memory usage history"
                            Data="{x:Bind ViewModel.MemoryChart, Mode=OneWay}"
                            Stroke="{ThemeResource MemoryAccentBrush}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.MemoryStats, Mode=OneWay}" />
                    </Grid>
                </Border>
            </controls:AdaptiveGridPanel>

            <!-- Top processes and health -->
            <controls:AdaptiveGridPanel MinItemWidth="420">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Top applications" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.ProcessCountText, Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Sort top applications by"
                                SelectedIndex="{x:Bind ViewModel.TopSortIndex, Mode=TwoWay}">
                                <x:String>By CPU</x:String>
                                <x:String>By memory</x:String>
                            </ComboBox>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopProcessItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                            <TextBlock MaxWidth="220" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind InstancesText, Mode=OneWay}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <controls:UsageBar
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Value="{x:Bind Percent, Mode=OneWay}" />
                                        <StackPanel Grid.Column="2" MinWidth="110" HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind PrimaryText, Mode=OneWay}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" Text="{x:Bind SecondaryText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Grid.Row="2" Padding="0" Command="{x:Bind ViewModel.OpenProcessesCommand}" Content="View all processes" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel MinHeight="32">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="System health" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.HealthSummary, Mode=OneWay}" ToolTipService.ToolTip="Instant indicators based on your health thresholds (Settings)" />
                        </StackPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HealthItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HealthItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:HealthGlyph VerticalAlignment="Top" Margin="0,2,0,0" Status="{x:Bind Status}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Grid.Row="2" Padding="0" Command="{x:Bind ViewModel.OpenPerformanceCommand}" Content="Open performance details" />
                    </Grid>
                </Border>
            </controls:AdaptiveGridPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
