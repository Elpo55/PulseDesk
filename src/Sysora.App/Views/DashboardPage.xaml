<Page
    x:Class="Sysora.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <!-- Header: how is my PC? -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_Dashboard}" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Padding="14,8"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind l:UiStrings.Dashboard_PCStatusOpenTheDiagnosis}"
                    Command="{x:Bind ViewModel.OpenDiagnosisCommand}"
                    CornerRadius="18"
                    ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_OpenTheDiagnosis}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:StatusIcon VerticalAlignment="Center" BrushKey="{x:Bind ViewModel.StatusBrushKey, Mode=OneWay}" Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" GlyphSize="18" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Performance -->
            <controls:AdaptiveGridPanel MinItemWidth="200">
                <controls:MetricCard
                    Title="{x:Bind l:UiStrings.Common_CPU}"
                    AccentBrush="{ThemeResource CpuAccentBrush}"
                    Detail="{x:Bind ViewModel.Cpu.Detail, Mode=OneWay}"
                    Glyph="&#xE950;"
                    Percent="{x:Bind ViewModel.Cpu.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Cpu.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.CpuSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Cpu.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="{x:Bind l:UiStrings.Dashboard_MEMORY}"
                    AccentBrush="{ThemeResource MemoryAccentBrush}"
                    Detail="{x:Bind ViewModel.Memory.Detail, Mode=OneWay}"
                    Glyph="&#xE964;"
                    Percent="{x:Bind ViewModel.Memory.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Memory.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.MemorySpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Memory.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="{x:Bind l:UiStrings.Common_GPU}"
                    AccentBrush="{ThemeResource GpuAccentBrush}"
                    Detail="{x:Bind ViewModel.Gpu.Detail, Mode=OneWay}"
                    Glyph="&#xEEA0;"
                    Percent="{x:Bind ViewModel.Gpu.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Gpu.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.GpuSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Gpu.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="{x:Bind l:UiStrings.Dashboard_SYSTEMDISK}"
                    AccentBrush="{ThemeResource DiskAccentBrush}"
                    Detail="{x:Bind ViewModel.Disk.Detail, Mode=OneWay}"
                    Glyph="&#xEDA2;"
                    Percent="{x:Bind ViewModel.Disk.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Disk.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.DiskSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Disk.Value, Mode=OneWay}" />
                <controls:MetricCard
                    Title="{x:Bind l:UiStrings.Dashboard_NETWORK}"
                    AccentBrush="{ThemeResource NetworkAccentBrush}"
                    Detail="{x:Bind ViewModel.Network.Detail, Mode=OneWay}"
                    Glyph="&#xE968;"
                    Percent="{x:Bind ViewModel.Network.Percent, Mode=OneWay}"
                    SecondaryDetail="{x:Bind ViewModel.Network.SecondaryDetail, Mode=OneWay}"
                    Sparkline="{x:Bind ViewModel.NetworkSpark, Mode=OneWay}"
                    Value="{x:Bind ViewModel.Network.Value, Mode=OneWay}" />
            </controls:AdaptiveGridPanel>

            <!-- PC Health and what changed since yesterday -->
            <controls:AdaptiveGridPanel MinItemWidth="420">
                <Button
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    AutomationProperties.Name="{x:Bind l:UiStrings.Dashboard_PCHealthOpenTheDetails}"
                    Command="{x:Bind ViewModel.OpenPcHealthCommand}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:StatusIcon VerticalAlignment="Top" BrushKey="{x:Bind ViewModel.HealthBrushKey, Mode=OneWay}" Glyph="{x:Bind ViewModel.HealthGlyph, Mode=OneWay}" GlyphSize="24" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Dashboard_PCHEALTH}" />
                            <TextBlock>
                                <Run FontSize="24" FontWeight="SemiBold" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" />
                                <Run Text="  " />
                                <Run Text="{x:Bind ViewModel.HealthGradeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.HealthDetail, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top"
                    AutomationProperties.Name="{x:Bind l:UiStrings.Dashboard_SinceYesterdayOpenChanges}"
                    Command="{x:Bind ViewModel.OpenChangesCommand}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Common_SINCEYESTERDAY}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasSignificantChanges, Mode=OneWay}">
                                <controls:StatusIcon BrushKey="StatusCriticalBrush" Glyph="&#xEA39;" GlyphSize="14" />
                                <TextBlock><Run Text="{x:Bind ViewModel.SignificantChanges, Mode=OneWay}" /><Run Text="{x:Bind l:UiStrings.Common_Significant}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.HasMinorChanges, Mode=OneWay}">
                                <controls:StatusIcon BrushKey="StatusWarningBrush" Glyph="&#xE7BA;" GlyphSize="14" />
                                <TextBlock><Run Text="{x:Bind ViewModel.MinorChanges, Mode=OneWay}" /><Run Text="{x:Bind l:UiStrings.Common_Minor}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.IsMostlyUnchanged, Mode=OneWay}">
                                <controls:StatusIcon BrushKey="StatusNormalBrush" Glyph="&#xE73E;" GlyphSize="14" />
                                <TextBlock Text="{x:Bind l:UiStrings.Common_MostOfYourSystemIsUnchanged}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SinceYesterdayHeadline, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.SinceYesterdayDetail, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </controls:AdaptiveGridPanel>

            <!-- Insights and quick actions -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Dashboard_Insights}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Insights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InsightItemViewModel">
                                    <Grid Padding="0,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:StatusIcon Margin="0,2,0,0" VerticalAlignment="Top" BrushKey="{x:Bind BrushKey, Mode=OneWay}" Glyph="{x:Bind Glyph, Mode=OneWay}" GlyphSize="14" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="2"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind l:UiStrings.Common_Details}"
                                            Command="{x:Bind OpenCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind l:UiStrings.Common_Details}"
                                            Visibility="{x:Bind HasAction, Mode=OneWay}">
                                            <FontIcon FontSize="12" Glyph="&#xE76C;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" MinWidth="220" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Dashboard_QuickActions}" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenDiagnosisCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_WhyIsMyPCSlow}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE95E;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Dashboard_Diagnose}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenTroubleshootingCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_InvestigateAProblemForAFewMinutesWithDetailed}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE90F;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Dashboard_Troubleshoot}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenTimelineCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_EverythingThatHappenedInOrder}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE823;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Common_Timeline}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenReplayCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_WhatHappenedInTheLastMinutes}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE81C;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Common_Replay}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenChangesCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_WhatChangedRecently}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE8AB;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Dashboard_ViewChanges}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenAppImpactCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_WhichApplicationWeighsTheMost}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE9F9;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Dashboard_AppImpact}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenAlertsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                                <TextBlock Text="{x:Bind ViewModel.AlertsText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{x:Bind ViewModel.OpenGamingCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_RecapsOfYourGameSessions}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE7FC;" />
                                <TextBlock MaxWidth="180" Text="{x:Bind ViewModel.GamingText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts -->
            <controls:AdaptiveGridPanel MinItemWidth="420">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_CPUUsage}" />
                            <ComboBox
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{x:Bind l:UiStrings.Common_ChartTimeSpan}"
                                ItemsSource="{x:Bind ViewModel.WindowOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
                        </Grid>
                        <controls:TimeSeriesChart
                            Grid.Row="1"
                            Height="180"
                            AutomationProperties.Name="{x:Bind l:UiStrings.Common_CPUUsageHistory}"
                            Data="{x:Bind ViewModel.CpuChart, Mode=OneWay}"
                            Stroke="{ThemeResource CpuAccentBrush}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.CpuStats, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid MinHeight="32">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_Memory}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" />
                        </Grid>
                        <controls:UsageBar
                            Grid.Row="1"
                            Foreground="{ThemeResource MemoryAccentBrush}"
                            Value="{x:Bind ViewModel.MemoryPercent, Mode=OneWay}" />
                        <controls:TimeSeriesChart
                            Grid.Row="2"
                            Height="164"
                            AutomationProperties.Name="{x:Bind l:UiStrings.Common_MemoryUsageHistory}"
                            Data="{x:Bind ViewModel.MemoryChart, Mode=OneWay}"
                            Stroke="{ThemeResource MemoryAccentBrush}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.MemoryStats, Mode=OneWay}" />
                    </Grid>
                </Border>
            </controls:AdaptiveGridPanel>

            <!-- Top processes and health -->
            <controls:AdaptiveGridPanel MinItemWidth="420">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Dashboard_TopApplications}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.ProcessCountText, Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind l:UiStrings.Dashboard_SortTopApplicationsBy}"
                                ItemsSource="{x:Bind ViewModel.TopSortOptions}"
                                SelectedIndex="{x:Bind ViewModel.TopSortIndex, Mode=TwoWay}" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopProcessItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                            <TextBlock MaxWidth="220" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind InstancesText, Mode=OneWay}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <controls:UsageBar
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Value="{x:Bind Percent, Mode=OneWay}" />
                                        <StackPanel Grid.Column="2" MinWidth="110" HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind PrimaryText, Mode=OneWay}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" Text="{x:Bind SecondaryText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Grid.Row="2" Padding="0" Command="{x:Bind ViewModel.OpenProcessesCommand}" Content="{x:Bind l:UiStrings.Dashboard_ViewAllProcesses}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel MinHeight="32">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Dashboard_SystemHealth}" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.HealthSummary, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Dashboard_InstantIndicatorsBasedOnYourHealthThresholds}" />
                        </StackPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.HealthItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HealthItemViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:HealthGlyph VerticalAlignment="Top" Margin="0,2,0,0" Status="{x:Bind Status}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Grid.Row="2" Padding="0" Command="{x:Bind ViewModel.OpenPerformanceCommand}" Content="{x:Bind l:UiStrings.Dashboard_OpenPerformanceDetails}" />
                    </Grid>
                </Border>
            </controls:AdaptiveGridPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
