<Page
    x:Class="Sysora.App.Views.LargeFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid MaxWidth="1200" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_LargeFiles}" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.LargeFiles_WhatTakesTheMostSpaceSysoraOnlyListsFilesItNever}" TextWrapping="Wrap" />
            </StackPanel>
            <Button AutomationProperties.Name="{x:Bind l:UiStrings.Common_Export}" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.ExportCommand}" IsEnabled="{x:Bind ViewModel.HasResult, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind l:UiStrings.LargeFiles_SaveTheResultsAsAnHTMLReportOrJSONData}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                    <TextBlock Text="{x:Bind l:UiStrings.Common_Export}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Scan -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Header="{x:Bind l:UiStrings.LargeFiles_Where}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Targets}"
                        SelectedItem="{x:Bind ViewModel.Target, Mode=TwoWay}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ChooseFolderCommand}" Content="{x:Bind l:UiStrings.LargeFiles_ChooseAFolder}" />
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="150"
                        Header="{x:Bind l:UiStrings.LargeFiles_FilesOf}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.MinimumSizes}"
                        SelectedItem="{x:Bind ViewModel.MinimumSize, Mode=TwoWay}" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.Name="{x:Bind l:UiStrings.LargeFiles_Scan}" Command="{x:Bind ViewModel.ScanCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE721;" />
                                <TextBlock Text="{x:Bind l:UiStrings.LargeFiles_Scan}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.CancelCommand}" Content="{x:Bind l:UiStrings.LargeFiles_Cancel}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.CurrentFolder, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.LargeFiles_TheScanRunsOnlyWhenYouAskAtLowPriorityAndCanBe}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Result message -->
        <StackPanel Grid.Row="2" Spacing="6" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
            <InfoBar IsClosable="False" IsOpen="True" Message="{x:Bind ViewModel.Message, Mode=OneWay}" Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}" />
            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}" TextWrapping="Wrap" />
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{x:Bind l:UiStrings.LargeFiles_FoldersNotReadLinksAndExclusions}" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ProblemsText, Mode=OneWay}" />
            </Expander>
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="3" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox MinWidth="150" AutomationProperties.Name="{x:Bind l:UiStrings.Common_View}" ItemsSource="{x:Bind ViewModel.Views}" SelectedIndex="{x:Bind ViewModel.ViewIndex, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" MinWidth="170" AutomationProperties.Name="{x:Bind l:UiStrings.LargeFiles_Type}" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.Category, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ShowFiles, Mode=OneWay}" />
            <TextBox Grid.Column="2" AutomationProperties.Name="{x:Bind l:UiStrings.LargeFiles_Search}" PlaceholderText="{x:Bind l:UiStrings.LargeFiles_SearchByNameOrFolder}" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind ViewModel.ShowFiles, Mode=OneWay}" />
        </Grid>

        <!-- Files -->
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Files}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowFiles, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LargeFileItemViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Folder}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Folder}" />
                            <TextBlock Style="{StaticResource LabelTextStyle}">
                                <Run Text="{x:Bind Type}" /><Run Text="{x:Bind l:UiStrings.LargeFiles_Modified}" /><Run Text="{x:Bind Modified}" />
                            </TextBlock>
                            <TextBlock Foreground="{ThemeResource StatusWarningBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Note}" TextWrapping="Wrap" Visibility="{x:Bind HasNote}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Size}" />
                            <controls:UsageBar Value="{x:Bind Share}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                            <Button AutomationProperties.Name="{x:Bind l:UiStrings.LargeFiles_ShowInFileExplorer}" Command="{x:Bind ShowInFolderCommand}" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{x:Bind l:UiStrings.LargeFiles_ShowInFileExplorer}">
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                            </Button>
                            <Button AutomationProperties.Name="{x:Bind l:UiStrings.LargeFiles_CopyThePath}" Command="{x:Bind CopyPathCommand}" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="{x:Bind l:UiStrings.LargeFiles_CopyThePath}">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Groups -->
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Groups}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.ShowGroups, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LargeFileGroupViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Count}" />
                        </StackPanel>
                        <controls:UsageBar Grid.Column="1" VerticalAlignment="Center" Value="{x:Bind Share}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Size}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
