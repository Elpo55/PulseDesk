<Page
    x:Class="Sysora.App.Views.ComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Compare" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="Before / after: how the PC behaved in two periods" />
                </StackPanel>
                <Button AutomationProperties.Name="Export" Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.ExportCommand}" IsEnabled="{x:Bind ViewModel.HasResult, Mode=OneWay}" ToolTipService.ToolTip="Save this comparison as an HTML report or JSON data">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <controls:AdaptiveGridPanel MinItemWidth="260" RowSpacing="12">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="Compare"
                            ItemsSource="{x:Bind ViewModel.Presets}"
                            SelectedItem="{x:Bind ViewModel.Preset, Mode=TwoWay}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="Game session"
                            ItemsSource="{x:Bind ViewModel.Sessions}"
                            PlaceholderText="No game session recorded"
                            SelectedItem="{x:Bind ViewModel.Session, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.NeedsSession, Mode=OneWay}" />
                    </controls:AdaptiveGridPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.NeedsFirstMoment, Mode=OneWay}">
                        <CalendarDatePicker Date="{x:Bind ViewModel.FirstDate, Mode=TwoWay}" Header="Moment (date)" />
                        <TimePicker Header="Time" Time="{x:Bind ViewModel.FirstTime, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.NeedsSecondMoment, Mode=OneWay}">
                        <CalendarDatePicker Date="{x:Bind ViewModel.SecondDate, Mode=TwoWay}" Header="Second moment (date)" />
                        <TimePicker Header="Time" Time="{x:Bind ViewModel.SecondTime, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button AutomationProperties.Name="Compare" Command="{x:Bind ViewModel.CompareCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE81E;" />
                                <TextBlock Text="Compare" />
                            </StackPanel>
                        </Button>
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="A moment is compared over the 10 minutes before it; &quot;before vs after a moment&quot; uses 15 minutes on each side. Recent periods use per-second measurements, older ones the per-minute or hourly history." TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <StackPanel MinWidth="760">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Metric" />
                                <TextBlock Grid.Column="1" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.BeforeLabel, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.AfterLabel, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource LabelTextStyle}" Text="Change" />
                                <TextBlock Grid.Column="4" MinWidth="120" Style="{StaticResource LabelTextStyle}" Text="Importance" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompareRowViewModel">
                                        <Grid Padding="0,6" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Explanation}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Before}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind After}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="{x:Bind DirectionGlyph}" />
                                                <TextBlock Text="{x:Bind Change}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <controls:LevelBadge Grid.Column="4" MinWidth="120" BrushKey="{x:Bind ImportanceBrushKey}" Text="{x:Bind ImportanceText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Padding="0,2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="What is compared" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Averages of CPU, memory, disk activity, GPU, network, processes and free space on the Windows volume, over each period. A metric measured in only one period is shown as not available and not compared. Percentages differ in percentage points; amounts also show the relative change." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
