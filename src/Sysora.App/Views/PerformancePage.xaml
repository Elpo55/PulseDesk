<Page
    x:Class="Sysora.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_Performance}" />
                    <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.Performance_RealTimeUsageAndRecentHistory}" />
                </StackPanel>
                <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind l:UiStrings.Common_ChartTimeSpan}"
                    Header="{x:Bind l:UiStrings.Common_TimeSpan}"
                    ItemsSource="{x:Bind ViewModel.WindowOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay}" />
            </Grid>

            <SelectorBar x:Name="Sections" SelectionChanged="OnSectionChanged">
                <SelectorBarItem Tag="Cpu" Text="{x:Bind l:UiStrings.Common_CPU}" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="Memory" Text="{x:Bind l:UiStrings.Common_Memory}">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE964;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="Gpu" Text="{x:Bind l:UiStrings.Common_GPU}">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xEEA0;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="Disk" Text="{x:Bind l:UiStrings.Performance_DiskActivity}">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- CPU -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsCpuSection, Mode=OneWay}">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_CPU}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource LargeValueTextStyle}" Text="{x:Bind ViewModel.Cpu.Usage, Mode=OneWay}" />
                        </Grid>
                        <controls:TimeSeriesChart
                            Grid.Row="1"
                            Height="240"
                            AutomationProperties.Name="{x:Bind l:UiStrings.Common_CPUUsageHistory}"
                            Data="{x:Bind ViewModel.Cpu.Chart, Mode=OneWay}"
                            Stroke="{ThemeResource CpuAccentBrush}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Cpu.Stats, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <controls:AdaptiveGridPanel MinItemWidth="150" RowSpacing="16">
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_Speed}" Value="{x:Bind ViewModel.Cpu.Speed, Mode=OneWay}" Hint="{x:Bind l:UiStrings.Performance_EffectiveClockRatedFrequencyCurrentProcessor}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_BaseSpeed}" Value="{x:Bind ViewModel.Cpu.BaseSpeed, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_PeakSpeedThisSession}" Value="{x:Bind ViewModel.Cpu.PeakSpeed, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_Temperature}" Value="{x:Bind ViewModel.Cpu.Temperature, Mode=OneWay}" Hint="{x:Bind ViewModel.TemperatureExplanation}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_Cores}" Value="{x:Bind ViewModel.Cpu.Cores, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_LogicalProcessors}" Value="{x:Bind ViewModel.Cpu.Threads, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_Sockets}" Value="{x:Bind ViewModel.Cpu.Sockets, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_L2Cache}" Value="{x:Bind ViewModel.Cpu.L2Cache, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_L3Cache}" Value="{x:Bind ViewModel.Cpu.L3Cache, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Common_Processes}" Value="{x:Bind ViewModel.Cpu.Processes, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Common_Threads}" Value="{x:Bind ViewModel.Cpu.ThreadsTotal, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Common_Handles}" Value="{x:Bind ViewModel.Cpu.Handles, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_UpTime}" Value="{x:Bind ViewModel.Cpu.Uptime, Mode=OneWay}" />
                    </controls:AdaptiveGridPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Performance_UsagePerLogicalProcessor}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cores}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinItemWidth="88"
                                    MinRowSpacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CoreUsageViewModel">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Label}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Text, Mode=OneWay}" />
                                        </Grid>
                                        <controls:UsageBar
                                            Foreground="{ThemeResource CpuAccentBrush}"
                                            Value="{x:Bind Percent, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Memory -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsMemorySection, Mode=OneWay}">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_MemoryInUse}" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource LargeValueTextStyle}" Text="{x:Bind ViewModel.Memory.Usage, Mode=OneWay}" />
                        </Grid>
                        <controls:TimeSeriesChart
                            Grid.Row="1"
                            Height="240"
                            AutomationProperties.Name="{x:Bind l:UiStrings.Common_MemoryUsageHistory}"
                            Data="{x:Bind ViewModel.Memory.Chart, Mode=OneWay}"
                            Stroke="{ThemeResource MemoryAccentBrush}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Memory.Stats, Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <controls:AdaptiveGridPanel MinItemWidth="170" RowSpacing="16">
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_InUse}" Value="{x:Bind ViewModel.Memory.InUse, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_Available}" Value="{x:Bind ViewModel.Memory.Available, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_UsableByWindows}" Value="{x:Bind ViewModel.Memory.Total, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_Installed}" Value="{x:Bind ViewModel.Memory.Installed, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Common_Committed}" Value="{x:Bind ViewModel.Memory.Committed, Mode=OneWay}" Hint="{x:Bind l:UiStrings.Performance_CommitChargeCommitLimitPhysicalMemoryPlusPage}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_SystemCache}" Value="{x:Bind ViewModel.Memory.Cached, Mode=OneWay}" Hint="{x:Bind l:UiStrings.Performance_StandbyListPlusSystemWorkingSetAsReportedBy}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_PagedPool}" Value="{x:Bind ViewModel.Memory.PagedPool, Mode=OneWay}" />
                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_NonPagedPool}" Value="{x:Bind ViewModel.Memory.NonPagedPool, Mode=OneWay}" />
                    </controls:AdaptiveGridPanel>
                </Border>
            </StackPanel>

            <!-- GPU -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsGpuSection, Mode=OneWay}">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasNoGpu, Mode=OneWay}"
                    Message="{x:Bind l:UiStrings.Performance_NoGraphicsAdapterDataIsAvailableGPUMonitoringMay}"
                    Severity="Informational" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Gpus}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GpuItemViewModel">
                            <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource LargeValueTextStyle}" Text="{x:Bind Usage, Mode=OneWay}" />
                                    </Grid>
                                    <controls:TimeSeriesChart
                                        Grid.Row="1"
                                        Height="200"
                                        Data="{x:Bind Chart, Mode=OneWay}"
                                        Stroke="{ThemeResource GpuAccentBrush}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Stats, Mode=OneWay}" />
                                    <controls:AdaptiveGridPanel Grid.Row="3" Margin="0,8,0,0" MinItemWidth="170" RowSpacing="16">
                                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_DedicatedMemory}" Value="{x:Bind Dedicated, Mode=OneWay}" />
                                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_SharedMemory}" Value="{x:Bind Shared, Mode=OneWay}" />
                                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_Temperature}" Value="{x:Bind Temperature, Mode=OneWay}" Hint="{x:Bind l:UiStrings.Performance_NotExposedByTheWindowsGPUPerformanceCounters}" />
                                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_ClockSpeed}" Value="{x:Bind Frequency, Mode=OneWay}" Hint="{x:Bind l:UiStrings.Performance_NotExposedByTheWindowsGPUPerformanceCounters}" />
                                        <controls:StatItem Label="{x:Bind l:UiStrings.Performance_BusiestEngines}" Value="{x:Bind Engines, Mode=OneWay}" />
                                    </controls:AdaptiveGridPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Disk activity -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsDiskSection, Mode=OneWay}">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasNoDisk, Mode=OneWay}"
                    Message="{x:Bind l:UiStrings.Performance_DiskActivityCountersAreNotAvailableOnThisSystem}"
                    Severity="Informational" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Disks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGridPanel MinItemWidth="380" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiskActivityItemViewModel">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind Drive, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Active, Mode=OneWay}" />
                                    </Grid>
                                    <controls:TimeSeriesChart Grid.Row="1" Height="140" Data="{x:Bind Chart, Mode=OneWay}" Stroke="{ThemeResource DiskAccentBrush}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Stats, Mode=OneWay}" />
                                    <Grid Grid.Row="3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <controls:StatItem Label="{x:Bind l:UiStrings.Common_Read}" Value="{x:Bind Read, Mode=OneWay}" />
                                        <controls:StatItem Grid.Column="1" Label="{x:Bind l:UiStrings.Common_Write}" Value="{x:Bind Write, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
