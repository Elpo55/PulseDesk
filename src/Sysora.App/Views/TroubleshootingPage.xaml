<Page
    x:Class="Sysora.App.Views.TroubleshootingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Sysora.Localization"
    xmlns:controls="using:Sysora.App.Controls"
    xmlns:troubleshooting="using:Sysora.Core.Troubleshooting"
    xmlns:vm="using:Sysora.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="FindingTemplate" x:DataType="vm:FindingItemViewModel">
            <Grid Padding="0,3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:LevelBadge VerticalAlignment="Top" BrushKey="{x:Bind BasisBrushKey}" Text="{x:Bind BasisText}" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="{x:Bind Label}" /><Run Text=": " /><Run Text="{x:Bind Text}" />
                </TextBlock>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LineTemplate" x:DataType="x:String">
            <TextBlock Padding="0,2" Text="{x:Bind}" TextWrapping="Wrap" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{x:Bind l:UiStrings.Common_Troubleshooting}" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_InvestigateAProblemForALimitedTimeSysoraCollects}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Start / progress -->
            <Border Padding="20" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Top" FontSize="28" Glyph="&#xE721;" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                            <ProgressBar Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.CountsText, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            MinWidth="140"
                            VerticalAlignment="Bottom"
                            Header="{x:Bind l:UiStrings.Common_Duration}"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Durations}"
                            SelectedItem="{x:Bind ViewModel.Duration, Mode=TwoWay}" />
                        <Button AutomationProperties.Name="{x:Bind l:UiStrings.Troubleshooting_StartInvestigation}" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.StartCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Troubleshooting_StartInvestigation}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{x:Bind l:UiStrings.Troubleshooting_StopNow}" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.StopCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                <TextBlock Text="{x:Bind l:UiStrings.Troubleshooting_StopNow}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_DuringTheInvestigationSysoraSamplesWithThe}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Report -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        MinWidth="320"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Bind l:UiStrings.Troubleshooting_Investigation}"
                        ItemsSource="{x:Bind ViewModel.Investigations}"
                        SelectedItem="{x:Bind ViewModel.SelectedInvestigation, Mode=TwoWay}" />
                    <Button AutomationProperties.Name="{x:Bind l:UiStrings.Troubleshooting_OpenInReplay}" Grid.Column="1" Command="{x:Bind ViewModel.OpenInReplayCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Troubleshooting_ShowTheInvestigatedPeriodInReplay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE81C;" />
                            <TextBlock Text="{x:Bind l:UiStrings.Troubleshooting_OpenInReplay}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{x:Bind l:UiStrings.Common_Export}" Grid.Column="2" Command="{x:Bind ViewModel.ExportCommand}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Troubleshooting_SaveTheReportAsAnHTMLPageOrJSONData}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                            <TextBlock Text="{x:Bind l:UiStrings.Common_Export}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Padding="20" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Headline, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind ViewModel.PeriodText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <controls:AdaptiveGridPanel MinItemWidth="420">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_CPUUsage}" />
                            <controls:TimeSeriesChart Height="120" AutomationProperties.Name="{x:Bind l:UiStrings.Troubleshooting_CPUUsageDuringTheInvestigation}" Data="{x:Bind ViewModel.CpuChart, Mode=OneWay}" Stroke="{ThemeResource CpuAccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_MemoryInUse}" />
                            <controls:TimeSeriesChart Height="120" AutomationProperties.Name="{x:Bind l:UiStrings.Troubleshooting_MemoryUsageDuringTheInvestigation}" Data="{x:Bind ViewModel.MemoryChart, Mode=OneWay}" Stroke="{ThemeResource MemoryAccentBrush}" />
                        </StackPanel>
                    </Border>
                </controls:AdaptiveGridPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Common_Measurements}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="troubleshooting:TroubleshootingMetric">
                                    <Grid Padding="0,3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Average}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Common_Average}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Peak}" ToolTipService.ToolTip="{x:Bind l:UiStrings.Troubleshooting_Peak}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_ColumnsAverageThenPeak}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_Anomalies}" />
                        <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{x:Bind ViewModel.Anomalies}" />
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Margin="0,8,0,0" Text="{x:Bind l:UiStrings.Troubleshooting_CorrelationsAndLikelyExplanations}" />
                        <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{x:Bind ViewModel.Correlations}" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_ObservedMeasuredInferredACoincidenceInThe}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <controls:AdaptiveGridPanel MinItemWidth="420">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_ApplicationsInvolved}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Applications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InvestigationAppViewModel">
                                        <StackPanel Padding="0,4">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Cpu}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Memory}" />
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="{x:Bind Note}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_Events}" />
                            <ScrollViewer MaxHeight="320">
                                <ItemsControl ItemTemplate="{StaticResource LineTemplate}" ItemsSource="{x:Bind ViewModel.Events}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </controls:AdaptiveGridPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="{x:Bind l:UiStrings.Troubleshooting_WhatCouldNotBeKnown}" />
                        <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{x:Bind ViewModel.Unknowns}" />
                        <TextBlock Style="{StaticResource CardHeaderTextStyle}" Margin="0,8,0,0" Text="{x:Bind l:UiStrings.Common_Recommendations}" />
                        <ItemsControl ItemTemplate="{StaticResource LineTemplate}" ItemsSource="{x:Bind ViewModel.Recommendations}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
