<UserControl
    x:Class="Sysora.App.Controls.TimeSeriesChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="120">

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Background="{ThemeResource ChartBackgroundBrush}"
            BorderBrush="{ThemeResource ChartGridBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid
                x:Name="Plot"
                Background="Transparent"
                PointerMoved="OnPlotPointerMoved"
                PointerPressed="OnPlotPointerPressed"
                SizeChanged="OnPlotSizeChanged">
                <!-- Horizontal grid lines at 25%, 50% and 75% of the scale. -->
                <Grid IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" BorderBrush="{ThemeResource ChartGridBrush}" BorderThickness="0,1,0,0" />
                    <Border Grid.Row="2" BorderBrush="{ThemeResource ChartGridBrush}" BorderThickness="0,1,0,0" />
                    <Border Grid.Row="3" BorderBrush="{ThemeResource ChartGridBrush}" BorderThickness="0,1,0,0" />
                </Grid>

                <Path x:Name="AreaPath" IsHitTestVisible="False" />
                <Path x:Name="LinePath" StrokeThickness="1.5" StrokeLineJoin="Round" IsHitTestVisible="False" />
                <Path x:Name="SecondaryLinePath" StrokeThickness="1.5" StrokeLineJoin="Round" IsHitTestVisible="False" />

                <!-- Replay: event markers along the top edge and the cursor (hidden unless set). -->
                <Path x:Name="MarkerPath" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" IsHitTestVisible="False" />
                <Rectangle
                    x:Name="CursorLine"
                    Width="2"
                    HorizontalAlignment="Left"
                    Fill="{ThemeResource TextFillColorPrimaryBrush}"
                    IsHitTestVisible="False"
                    Opacity="0.8"
                    Visibility="Collapsed">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="CursorTransform" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <TextBlock
                    x:Name="MaximumLabel"
                    Margin="6,4,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Style="{StaticResource LabelTextStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{x:Bind ShowAxisLabels, Mode=OneWay}">
            <TextBlock x:Name="WindowLabel" Style="{StaticResource LabelTextStyle}" />
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" Text="Now" />
        </Grid>
    </Grid>
</UserControl>
