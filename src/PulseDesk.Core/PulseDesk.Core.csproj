<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PulseDesk.Core: domain models, interfaces, monitoring orchestration and pure logic.
    Must stay platform-agnostic: no WinUI, no P/Invoke, no Windows-only APIs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PulseDesk.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PulseDesk.Tests" />
  </ItemGroup>

</Project>
