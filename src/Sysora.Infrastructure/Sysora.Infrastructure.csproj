<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sysora.Infrastructure: implementations of the Core interfaces that work on every operating system
    (settings file, SQLite history, log files, large-file scan, data folders) and the Linux and macOS adapters.
    The Windows adapters are in Sysora.Infrastructure.Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sysora.Infrastructure</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sysora.Core\Sysora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sysora.Infrastructure.Windows" />
    <InternalsVisibleTo Include="Sysora.Tests" />
  </ItemGroup>

</Project>
